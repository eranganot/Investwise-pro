__pycache__/
*.pyc
*.db
.venv/
.env

# Written by scripts/get-error-log.ps1 on every run.
scripts/railway-error.log

# Local agent/session state -- noise on every git status, and noise is where a
# real modified file hides. Portable copies live in the account skill library.
.claude/

# Staging for files the device bridge cannot delete; remove by hand.
_to_delete/

# Installed packages, never source. 2,463 of these were tracked until
# 2026-08-15: every git status walked them and timed out at 40s, and -- the
# expensive part -- git status --short returned an EMPTY view while five files
# sat staged, which was very nearly reported as a clean tree. The git add -A
# ban documented in .gitattributes was treating that symptom; this is the cause.
node_modules/

# Patches handed over for git am. Untracked, and git stash -u swept one
# into the stash mid-handover -- ignored files are left alone.
*.patch

# The agent API key, when kept out of the tracked scripts. scripts/agent-key.ps1
# reads this file if it exists. One line, no quotes. Never commit it -- the whole
# point is that it is the copy that is NOT in the history.
scripts/.agent-key*

# Source tarballs. `git archive` snapshots made to move the tree between this
# box and a sandbox: 1.7 MB each, byte-identical to a commit that is already in
# the history, and they sat in `git status` for days as untracked noise -- the
# exact hazard the node_modules rule above is written about. Regenerate rather
# than keep one: `git archive --format=tar.gz -o iw-src.tgz HEAD`.
*.tgz
*.tar.gz

.claude/settings.local.json

# Smoke-script scratch output (PR 88+): a baseline the next PR diffs against.
scripts/smoke/baseline-*.json
