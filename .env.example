# Copy to .env for local development. Every setting and its default: app/core/config.py.
# Production values: docs/OPERATIONS.md section 3. Never commit real secrets.

# --- Runtime ---
ENVIRONMENT=development
DEBUG=true
# Dev convenience: build the schema with create_all at boot. Production leaves this false;
# Alembic owns the schema there (run `alembic upgrade head` locally to do it the production way).
AUTO_CREATE_TABLES=true
# APScheduler jobs + Today warm-up loop. Set false for a quiet local server.
ENABLE_SCHEDULER=true

# --- Database (async Postgres). Railway/Heroku-style postgres:// is auto-normalized. ---
DATABASE_URL=postgresql+asyncpg://investwise:investwise@localhost:5432/investwise

# --- Market data. Defaults are deterministic illustrative data; these give live data (no key needed). ---
MARKET_DATA_PROVIDER=yahoo
FX_PROVIDER=frankfurter
# FMP_API_KEY=

# --- Auth. Default is open demo mode (everyone is SUPERADMIN). ---
REQUIRE_AUTH=false
# JWT_SECRET=                     # set, or every restart logs everyone out
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
# ALLOWED_EMAILS=you@example.com
# AGENT_API_KEY=                  # X-Agent-Key header -> SUPERADMIN (scripts); see docs/ROTATION.md
# AUTH_PASSWORD=                  # password login; blank = off

# --- Web push (blank = a pair is generated and stored in the DB; pin it in production) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- LLM (Gemini). Blank = AI features off; the app still runs. ---
# GOOGLE_API_KEY=

# --- Frontend (CORS origin; the PWA is same-origin, so this rarely matters) ---
# FRONTEND_ORIGIN=  (empty: no cross-origin access; the app is same-origin at /app)

# --- SuperAdmin ---
SUPERADMIN_NAME=Eran Ganot
TAX_YEAR=2026

# --- Tax engine (CONFIRM with accountant; config-driven, not hardcoded) ---
CGT_RATE=0.25
SURTAX_RATE=0.05
SURTAX_THRESHOLD_ILS=721000

# --- Risk engine ---
MAX_DRAWDOWN_CAP=0.20
VOLATILITY_CAP=0.15
MONTE_CARLO_RUNS=10000

# --- Decision engine thresholds ---
MIN_IMPACT_SCORE=20
MIN_CONFIDENCE=60
